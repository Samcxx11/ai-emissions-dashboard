st.markdown(divider(), unsafe_allow_html=True)

# ── Why This Matters ──────────────────────────────────────────────────────────
st.markdown(chapter(2, "Why This Matters"), unsafe_allow_html=True)

why_col1, why_col2, why_col3 = st.columns(3)

with why_col1:
    st.markdown(big_number(1), unsafe_allow_html=True)
    st.markdown("### Scale")
    st.markdown(
        "AI is now used billions of times a day — search, chatbots, coding "
        "assistants. Even a small per-query energy cost adds up massively at "
        "that scale."
    )

with why_col2:
    st.markdown(big_number(2), unsafe_allow_html=True)
    st.markdown("### Invisibility")
    st.markdown(
        "Nobody sees the electricity bill behind an AI answer the way they "
        "see a car's exhaust. This project makes an invisible cost visible."
    )

with why_col3:
    st.markdown(big_number(3), unsafe_allow_html=True)
    st.markdown("### Research Gap")
    st.markdown(
